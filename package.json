{
  "name": "crypto-risk-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Crypto watchlist, risk and trend scores, technical indicators, ranges, backtests and a top-250 screener, using the free CoinGecko API in EUR.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "pwa-assets-generator"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0"
  }
}
